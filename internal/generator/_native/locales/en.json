        "type": "String",
        "example": "1.2.0"
      }
    }
  },
  "updateProgressLabel": "Update progress",
  "updateInstalled": "Version {version} is installed.",
  "@updateInstalled": {
    "placeholders": {
      "version": {
        "type": "String",
        "example": "1.2.0"
      }
    }
